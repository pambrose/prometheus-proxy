# The coffee shop's load balancer (docker/compose.yml), on the port the demo publishes, as a platform's own is: every
# request goes to version 1.0, or, once a deploy has stopped it, to version 1.1, so the shop keeps one address through a
# deploy. Caddy resolves each name as it connects, so it starts while coffee-shop-next, which only a deploy starts,
# doesn't exist.
{
	admin off
	auto_https off
}

:8080 {
	reverse_proxy coffee-shop:8080 coffee-shop-next:8080 {
		# The first one that answers, in this order: 1.0 while it runs, then 1.1
		lb_policy first
		# A request whose version has gone is tried on the other, for up to 5 seconds, and the one that failed is passed
		# over for the next 2, which is long enough to move a deploy's requests along and short enough that a version
		# started again, as a rollback starts 1.0, gets them back at once. Passive only: an active health check would log
		# an error every few seconds for coffee-shop-next whenever no deploy is running.
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 2s
	}
}
