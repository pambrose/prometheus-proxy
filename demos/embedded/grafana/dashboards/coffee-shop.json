            "uid": "${datasource}"
          },
          "expr": "max(coffee_baristas)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Rush hour",
      "description": "During a rush, customers order three times as often.",
