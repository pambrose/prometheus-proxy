        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Working",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Broken",
                  "color": "red",
                  "index": 1
                }
              }
            }
