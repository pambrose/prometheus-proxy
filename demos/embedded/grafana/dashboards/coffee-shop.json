          "expr": "max(coffee_queue_depth)",
          "legendFormat": "queue",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(coffee_baristas)",
          "legendFormat": "baristas",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Brew time, p50 and p95",
      "description": "How long a drink took to brew once a barista picked it up.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
