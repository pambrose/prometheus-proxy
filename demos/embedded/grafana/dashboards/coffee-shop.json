          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coffee_brew_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
